# Copy to .env and fill in real values. .env is gitignored; this file is not,
# and must never contain a real secret.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, RDS, local — anything Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/vinx?schema=public"

# The site's own origin. Must be the real https URL in production — payment
# providers redirect back here, and NextAuth only marks cookies Secure once
# this is https.
NEXTAUTH_URL="http://localhost:3000"

# Signs session tokens. Generate with: openssl rand -base64 32
# Changing it in production logs everyone out.
NEXTAUTH_SECRET=""

# ---------------------------------------------------------------------------
# Media storage
#
# Any S3-compatible host works. Cloudflare R2 and DigitalOcean Spaces need
# S3_ENDPOINT set; real AWS S3 leaves it blank.
#
# STORAGE_DRIVER overrides the choice of backend:
#   local  - write uploads to ./public/uploads on this machine (development
#            only). Use this to fill the catalog before you have a bucket, or
#            to get unstuck when the S3_* values below are wrong.
#   s3     - force S3 even if the values look incomplete.
#   unset  - decide automatically: S3 when credentials and a non-placeholder
#            bucket are present, otherwise local in development.
#
# Uploads written locally live outside the database and are gitignored, so
# move to a bucket before deploying — the files will not exist on the server.
STORAGE_DRIVER="local"
# ---------------------------------------------------------------------------

# AWS: the bucket's region (eu-west-1, us-east-1, …). R2: use "auto".
S3_REGION="auto"

# Leave BLANK for real AWS S3. Otherwise the provider's S3 API endpoint, e.g.
#   Cloudflare R2:        https://<account-id>.r2.cloudflarestorage.com
#   DigitalOcean Spaces:  https://fra1.digitaloceanspaces.com
S3_ENDPOINT=""

S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# The bucket uploads are written to.
S3_BUCKET="vinx-media"

# Public base URL the bucket serves files from — a CDN domain or the bucket's
# public URL. Stored image/video URLs are built from this, and next.config.js
# scopes the image optimizer to this host, so getting it wrong means product
# images silently refuse to render. No trailing slash.
S3_PUBLIC_URL_BASE="https://media.example.com"

# ---------------------------------------------------------------------------
# Payments — only needed for the providers you actually offer
# ---------------------------------------------------------------------------

# Paystack: cards, MTN MoMo, Telecel Cash, AirtelTigo Money.
# Webhook URL -> https://yourdomain.com/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=""

# Stripe: international cards.
# Webhook URL -> https://yourdomain.com/api/payments/stripe/webhook
# subscribed to checkout.session.completed
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal. Leave PAYPAL_API_BASE blank for live; use the sandbox URL to test:
#   https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_BASE=""

# ---------------------------------------------------------------------------
# Optional hardening
# ---------------------------------------------------------------------------

# Comma-separated IPs. When set, /admin is unreachable from anywhere else —
# checked before login or role. Only set this once you have a static office or
# VPN IP, or you will lock yourself out of your own admin.
ADMIN_IP_ALLOWLIST=""

# Rate limiting falls back to an in-memory limiter when these are unset, which
# is correct for exactly one server instance. Set them before running more.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

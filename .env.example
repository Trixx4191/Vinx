# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already in .gitignore.
#
# IMPORTANT naming rule: any variable prefixed NEXT_PUBLIC_ gets bundled
# into client-side JavaScript and is visible to anyone via devtools. Only
# ever put genuinely public values (publishable keys, not secret keys)
# behind that prefix. Everything else here has no prefix on purpose, which
# keeps it server-only — Next.js will not expose it to the browser.

# PostgreSQL connection string (use a managed provider: Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://user:password@host:5432/vinx?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Stripe — secret key stays server-only, publishable key is meant to be public
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Paystack (cards + MTN MoMo + Telecel Cash + AirtelTigo Money)
PAYSTACK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# PayPal — both stay server-only; PayPal's JS SDK is loaded via a script
# with the client ID as a URL param at integration time, not an env var
# baked into the bundle
PAYPAL_CLIENT_ID="xxx"
PAYPAL_CLIENT_SECRET="xxx"
# sandbox for testing, switch to https://api-m.paypal.com in production
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# Optional: comma-separated exact IPs allowed to reach /admin at all,
# checked before login/role. Leave unset to skip this check (e.g. local dev).
ADMIN_IP_ALLOWLIST=""

# S3-compatible object storage for product images (works with AWS S3,
# Cloudflare R2, DigitalOcean Spaces, etc.)
S3_BUCKET="vinx-product-images"
S3_REGION="auto"
S3_ENDPOINT="" # leave blank for real AWS S3; set for R2/Spaces/etc.
S3_ACCESS_KEY_ID="xxx"
S3_SECRET_ACCESS_KEY="xxx"
S3_PUBLIC_URL_BASE="https://vinx-product-images.s3.amazonaws.com"
